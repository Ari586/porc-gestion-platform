PORT=3000

# Restrict browser/app origins in production.
# Example: https://porc-gestion-platform.web.app
CORS_ORIGIN=*

# LiveKit server credentials
LIVEKIT_URL=wss://YOUR-LIVEKIT-ENDPOINT
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# Optional additional auth between Flutter app and this token API.
# If set, Flutter must send this value in header x-client-secret.
# CLIENT_SHARED_SECRET=CHANGE_ME
