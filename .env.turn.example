# Copy to .env.turn and fill your TURN values.
# Do not commit .env.turn.

PROJECT_ID=porc-gestion-platform
CALL_TRANSPORT=webrtc
WEBRTC_FORCE_RELAY=true

# Required when CALL_TRANSPORT=webrtc
WEBRTC_TURN_URLS=turns:YOUR_TURN_HOST:443?transport=tcp,turn:YOUR_TURN_HOST:3478?transport=udp,turn:YOUR_TURN_HOST:3478?transport=tcp
WEBRTC_TURN_USERNAME=YOUR_USERNAME
WEBRTC_TURN_CREDENTIAL=YOUR_PASSWORD

# Optional backup TURN provider
# WEBRTC_TURN_URLS_2=turns:BACKUP_TURN_HOST:443?transport=tcp
# WEBRTC_TURN_USERNAME_2=BACKUP_USERNAME
# WEBRTC_TURN_CREDENTIAL_2=BACKUP_PASSWORD

# Optional third TURN provider (recommended for global failover)
# WEBRTC_TURN_URLS_3=turns:BACKUP2_TURN_HOST:443?transport=tcp
# WEBRTC_TURN_USERNAME_3=BACKUP2_USERNAME
# WEBRTC_TURN_CREDENTIAL_3=BACKUP2_PASSWORD

# Optional STUN override
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Required when CALL_TRANSPORT=livekit
# LIVEKIT_TOKEN_ENDPOINT=https://YOUR_BACKEND/livekit/token

# Optional when backend returns empty url field
# LIVEKIT_URL=wss://YOUR-LIVEKIT-HOST

# Optional shared secret expected by your token backend
# LIVEKIT_CLIENT_SECRET=CHANGE_ME

# Optional Firebase defines for web build/deploy
# FIREBASE_API_KEY=...
# FIREBASE_APP_ID=...
# FIREBASE_PROJECT_ID=...
# FIREBASE_MESSAGING_SENDER_ID=...
# FIREBASE_AUTH_DOMAIN=...
# FIREBASE_STORAGE_BUCKET=...
# FIREBASE_DATABASE_URL=...
# FIREBASE_MEASUREMENT_ID=...
# FIREBASE_WEB_PUSH_VAPID_KEY=...
