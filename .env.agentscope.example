# Copy values into a local `.env.agentscope` file. Do not commit real secrets.

# Choose one provider and set its matching API key.
AGENTSCOPE_PROVIDER=openai
AGENTSCOPE_MODEL=gpt-4.1-mini

# OpenAI
OPENAI_API_KEY=
# Optional for OpenAI-compatible endpoints such as proxy gateways.
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter
# AGENTSCOPE_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_NAME=porc-agentscope

# Anthropic
# AGENTSCOPE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Gemini
# AGENTSCOPE_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# DashScope
# AGENTSCOPE_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
