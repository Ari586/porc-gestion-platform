rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /porc_realtime_sync/chat_news_v1 {
      allow read: if true;
      allow create, update: if
          request.resource.data.chatMessages is list &&
          request.resource.data.newsPosts is list &&
          request.resource.data.chatMessages.size() <= 2500 &&
          request.resource.data.newsPosts.size() <= 400 &&
          request.resource.data.updatedByUserId is string &&
          request.resource.data.updatedByClientId is string;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
